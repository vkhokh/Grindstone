rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isValidProfile(d) {
      return d.keys().hasOnly([
          'uid',
          'email',
          'name',
          'gender',
          'heightCm',
          'weightKg',
          'photoBase64',
          'createdAt',
          'updatedAt'
        ])
        && d.name is string
        && d.name.size() >= 2
        && (!('uid' in d) || d.uid == request.auth.uid)
        && (!('email' in d) || request.auth.token.email == null || d.email == request.auth.token.email)
        && (!('gender' in d) || d.gender in ['male', 'female', null])
        && (!('heightCm' in d) || (d.heightCm is number && d.heightCm >= 100 && d.heightCm <= 250))
        && (!('weightKg' in d) || (d.weightKg is number && d.weightKg >= 30 && d.weightKg <= 300))
        && (!('photoBase64' in d) || (d.photoBase64 is string && d.photoBase64.size() <= 1200000))
        && (!('createdAt' in d) || d.createdAt is timestamp)
        && (!('updatedAt' in d) || d.updatedAt is timestamp);
    }

    function isValidTrainingBasicInfo(d) {
      return d is map
        && d.keys().hasOnly(['name', 'description', 'hasTraining'])
        && d.name is string
        && d.name.size() >= 1
        && (!('description' in d) || d.description is string)
        && (!('hasTraining' in d) || d.hasTraining is bool);
    }

    function isValidWorkoutArchive(d) {
      return d.keys().hasOnly([
          'training',
          'exerciseCount',
          'approachCount',
          'completedAt'
        ])
        && d.training is map
        && d.training.keys().hasOnly(['basicInfo', 'exercises'])
        && isValidTrainingBasicInfo(d.training.basicInfo)
        && d.training.exercises is list
        && d.exerciseCount is int
        && d.exerciseCount >= 0
        && d.exerciseCount == d.training.exercises.size()
        && d.approachCount is int
        && d.approachCount >= 0
        && d.completedAt is timestamp;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidProfile(request.resource.data);
      allow delete: if isOwner(uid);

      match /workoutArchive/{trainingId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidWorkoutArchive(request.resource.data);
        allow delete: if isOwner(uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
