rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isVerifiedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function isVerifiedOwner(uid) {
      return isOwner(uid) && isVerifiedUser();
    }

    function isValidProfile(d) {
      return d.keys().hasOnly([
          'uid',
          'email',
          'name',
          'gender',
          'heightCm',
          'weightKg',
          'photoBase64',
          'createdAt',
          'updatedAt'
        ])
        && d.name is string
        && d.name.size() >= 2
        && (!('uid' in d) || d.uid == request.auth.uid)
        && (!('email' in d) || request.auth.token.email == null || d.email == request.auth.token.email)
        && (!('gender' in d) || d.gender in ['male', 'female', null])
        && (!('heightCm' in d) || (d.heightCm is number && d.heightCm >= 100 && d.heightCm <= 250))
        && (!('weightKg' in d) || (d.weightKg is number && d.weightKg >= 30 && d.weightKg <= 300))
        && (!('photoBase64' in d) || (d.photoBase64 is string && d.photoBase64.size() <= 1200000))
        && (!('createdAt' in d) || d.createdAt is timestamp)
        && (!('updatedAt' in d) || d.updatedAt is timestamp);
    }

    function isValidTrainingBasicInfo(d) {
      return d is map
        && d.keys().hasOnly(['name', 'description', 'hasTraining'])
        && d.name is string
        && d.name.size() >= 1
        && (!('description' in d) || d.description is string)
        && (!('hasTraining' in d) || d.hasTraining is bool);
    }

    function isValidWorkoutArchive(d) {
      return d.keys().hasOnly([
          'training',
          'exerciseCount',
          'approachCount',
          'completedAt'
        ])
        && d.training is map
        && d.training.keys().hasOnly(['basicInfo', 'exercises'])
        && isValidTrainingBasicInfo(d.training.basicInfo)
        && d.training.exercises is list
        && d.exerciseCount is int
        && d.exerciseCount >= 0
        && d.exerciseCount == d.training.exercises.size()
        && d.approachCount is int
        && d.approachCount >= 0
        && d.completedAt is timestamp;
    }

    function isValidTrackingType(value) {
      return value in ['weightReps', 'bodyweightReps', 'duration'];
    }

    function isValidProgressOverview(d) {
      return d.keys().hasOnly([
          'totalTrainings',
          'totalExerciseSessions',
          'totalApproaches',
          'uniqueExercises',
          'totalVolumeKg',
          'totalDurationSeconds',
          'lastCompletedAt',
          'generatedAt',
          'schemaVersion'
        ])
        && d.totalTrainings is int
        && d.totalTrainings >= 0
        && d.totalExerciseSessions is int
        && d.totalExerciseSessions >= 0
        && d.totalApproaches is int
        && d.totalApproaches >= 0
        && d.uniqueExercises is int
        && d.uniqueExercises >= 0
        && d.totalVolumeKg is number
        && d.totalVolumeKg >= 0
        && d.totalDurationSeconds is int
        && d.totalDurationSeconds >= 0
        && (!('lastCompletedAt' in d) || d.lastCompletedAt is timestamp)
        && d.generatedAt is timestamp
        && d.schemaVersion is int
        && d.schemaVersion == 1;
    }

    function isValidExerciseProgress(d) {
      return d.keys().hasOnly([
          'exerciseKey',
          'exerciseId',
          'exerciseName',
          'trackingType',
          'sessionCount',
          'approachCount',
          'personalBestValue',
          'bestWeightKg',
          'bestReps',
          'bestAdditionalWeightKg',
          'bestTotalLoadKg',
          'bestDurationSeconds',
          'totalVolumeKg',
          'totalDurationSeconds',
          'firstPerformanceValue',
          'latestPerformanceValue',
          'improvementValue',
          'improvementPercent',
          'lastCompletedAt'
        ])
        && d.exerciseKey is string
        && d.exerciseKey.size() >= 1
        && d.exerciseName is string
        && d.exerciseName.size() >= 1
        && (!('exerciseId' in d) || d.exerciseId is string)
        && isValidTrackingType(d.trackingType)
        && d.sessionCount is int
        && d.sessionCount >= 0
        && d.approachCount is int
        && d.approachCount >= 0
        && d.personalBestValue is number
        && d.personalBestValue >= 0
        && (!('bestWeightKg' in d) || (d.bestWeightKg is number && d.bestWeightKg >= 0))
        && (!('bestReps' in d) || (d.bestReps is int && d.bestReps >= 0))
        && (!('bestAdditionalWeightKg' in d) || (d.bestAdditionalWeightKg is number && d.bestAdditionalWeightKg >= 0))
        && (!('bestTotalLoadKg' in d) || (d.bestTotalLoadKg is number && d.bestTotalLoadKg >= 0))
        && (!('bestDurationSeconds' in d) || (d.bestDurationSeconds is int && d.bestDurationSeconds >= 0))
        && d.totalVolumeKg is number
        && d.totalVolumeKg >= 0
        && d.totalDurationSeconds is int
        && d.totalDurationSeconds >= 0
        && (!('firstPerformanceValue' in d) || (d.firstPerformanceValue is number && d.firstPerformanceValue >= 0))
        && (!('latestPerformanceValue' in d) || (d.latestPerformanceValue is number && d.latestPerformanceValue >= 0))
        && d.improvementValue is number
        && (!('improvementPercent' in d) || d.improvementPercent is number)
        && (!('lastCompletedAt' in d) || d.lastCompletedAt is timestamp);
    }

    function isValidExerciseProgressPoint(d) {
      return d.keys().hasOnly([
          'trainingId',
          'trainingName',
          'completedAt',
          'performanceValue',
          'bestWeightKg',
          'bestReps',
          'bestAdditionalWeightKg',
          'bestTotalLoadKg',
          'bestDurationSeconds',
          'totalVolumeKg',
          'totalDurationSeconds',
          'approachCount',
          'orderIndex'
        ])
        && d.trainingId is string
        && d.trainingId.size() >= 1
        && d.trainingName is string
        && d.trainingName.size() >= 1
        && d.completedAt is timestamp
        && d.performanceValue is number
        && d.performanceValue >= 0
        && (!('bestWeightKg' in d) || (d.bestWeightKg is number && d.bestWeightKg >= 0))
        && (!('bestReps' in d) || (d.bestReps is int && d.bestReps >= 0))
        && (!('bestAdditionalWeightKg' in d) || (d.bestAdditionalWeightKg is number && d.bestAdditionalWeightKg >= 0))
        && (!('bestTotalLoadKg' in d) || (d.bestTotalLoadKg is number && d.bestTotalLoadKg >= 0))
        && (!('bestDurationSeconds' in d) || (d.bestDurationSeconds is int && d.bestDurationSeconds >= 0))
        && d.totalVolumeKg is number
        && d.totalVolumeKg >= 0
        && d.totalDurationSeconds is int
        && d.totalDurationSeconds >= 0
        && d.approachCount is int
        && d.approachCount >= 0
        && d.orderIndex is int
        && d.orderIndex >= 0;
    }

    match /users/{uid} {
      allow read: if isVerifiedOwner(uid);
      allow create, update: if isVerifiedOwner(uid) && isValidProfile(request.resource.data);
      allow delete: if isVerifiedOwner(uid);

      match /workoutArchive/{trainingId} {
        allow read: if isVerifiedOwner(uid);
        allow create, update: if isVerifiedOwner(uid) && isValidWorkoutArchive(request.resource.data);
        allow delete: if isVerifiedOwner(uid);
      }

      match /progressOverview/{documentId} {
        allow read: if isVerifiedOwner(uid);
        allow create, update: if isVerifiedOwner(uid) && isValidProgressOverview(request.resource.data);
        allow delete: if isVerifiedOwner(uid);
      }

      match /exerciseProgress/{exerciseKey} {
        allow read: if isVerifiedOwner(uid);
        allow create, update: if isVerifiedOwner(uid) && isValidExerciseProgress(request.resource.data);
        allow delete: if isVerifiedOwner(uid);

        match /points/{pointId} {
          allow read: if isVerifiedOwner(uid);
          allow create, update: if isVerifiedOwner(uid) && isValidExerciseProgressPoint(request.resource.data);
          allow delete: if isVerifiedOwner(uid);
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
